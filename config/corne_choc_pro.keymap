#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

#define MOUSE 1
#define RIGHT_PUNC 2
#define NAVIGATION 3
#define NUMPAD 4
#define LEFT_PUNC 5
#define FUNCTION 6

/ {
    behaviors {
        inc_dec_ms: inc_dec_ms {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };
};

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | CAPS | NLCK |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTL/D | SFT/F |  G  |     |     |  H  | SFT/J | CTL/K | ALT/L | GUI/; |
            // |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M  |  ,  |  .  |  /  |
            //                    | ESC | SPC | TAB |       | ENT | BSPC | DEL |
            //                    |MOUSE|R_PUNC| NAV |   |NUMPAD|L_PUNC| FUNC|
            bindings = <
                &kp Q           &kp W           &kp E           &kp R           &kp T           &kp CAPSLOCK    &kp KP_NUMLOCK   &kp Y           &kp U           &kp I           &kp O           &kp P
                &mt LGUI A      &mt LALT S      &mt LCTL D      &mt LSHFT F     &kp G           &trans          &trans           &kp H           &mt RSHFT J     &mt RCTL K      &mt RALT L      &mt RGUI SEMI
                &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
                &lt MOUSE ESC   &lt RIGHT_PUNC SPACE  &lt NAVIGATION TAB  &lt NUMPAD RET  &lt LEFT_PUNC BSPC  &lt FUNCTION DEL
            >;
            sensor-bindings = <&inc_dec_ms SCRL_LEFT SCRL_RIGHT &inc_dec_ms SCRL_LEFT SCRL_RIGHT &inc_dec_ms SCRL_UP SCRL_DOWN &inc_dec_ms SCRL_UP SCRL_DOWN>;
        };

        mouse_layer {
            display-name = "Mouse";
            // --------------------------------------------------------------------------------
            // |     |     |     |     |     |     |     | BT0 | BT1 | BT2 | BT3 | BT4 |
            // | LGUI | LALT | LCTL | LSHFT |     |     |     |BTCLR| M_LFT | M_DN | M_UP | M_RT |
            // |     |     |     |     |     |               |BTCLR| W_LFT | W_DN | W_UP | W_RT |
            //                    |     |     |     |       |L_CLK | M_CLK | R_CLK |
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &kp LGUI        &kp LALT        &kp LCTL        &kp LSHFT       &trans          &trans          &trans          &bt BT_CLR      &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT
                &trans          &trans          &trans          &trans          &trans          &bt BT_CLR_ALL  &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT
                &trans          &trans          &trans          &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        right_punc_layer {
            display-name = "Right Punctuation";
            // --------------------------------------------------------------------------------
            // |     | RET | DEL | BSPC |     |     |     |     |  {  |  }  |  "  |  |  |
            // | LGUI | LALT | LCTL | LSHFT |     |     |     |     |  (  |  )  |  '  |  \  |
            // | Undo | Cut | Copy | Paste |     |               |     |  [  |  ]  |  `  |  ~  |
            //                    |     |     |     |       |     | BSPC | DEL |
            bindings = <
                &trans          &kp RET         &kp DEL         &kp BSPC        &trans          &trans          &trans          &trans          &kp LBRC        &kp RBRC        &kp DQT         &kp PIPE
                &kp LGUI        &kp LALT        &kp LCTL        &kp LSHFT       &trans          &trans          &trans          &trans          &kp LPAR        &kp RPAR        &kp SQT         &kp BSLH
                &kp K_UNDO      &kp K_CUT       &kp K_COPY      &kp K_PASTE     &trans          &trans          &kp LBKT        &kp RBKT        &kp GRAVE       &kp TILDE
                &trans          &trans          &trans          &kp RET         &kp BSPC        &kp DEL
            >;
        };

        navigation_layer {
            display-name = "Navigation";
            // --------------------------------------------------------------------------------
            // |     |     |     |     |     |     |     |     | PSCRN | SLCK | PAUSE | INS |
            // | LGUI | LALT | LCTL | LSHFT |     |     |     |     | LEFT | DOWN | UP | RIGHT |
            // |     |     |     |     |     |               |     | HOME | PG_DN | PG_UP | END |
            //                    |     |     |     |       | RET | BSPC | DEL |
            bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp PSCRN       &kp SLCK        &kp PAUSE_BREAK &kp INS
                &kp LGUI        &kp LALT        &kp LCTL        &kp LSHFT       &trans          &trans          &trans          &trans          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT
                &trans          &trans          &trans          &trans          &trans          &trans          &kp HOME        &kp PG_DN       &kp PG_UP       &kp END
                &trans          &trans          &trans          &kp RET         &kp BSPC        &kp DEL
            >;
        };

        numpad_layer {
            display-name = "NumPad";
            // --------------------------------------------------------------------------------
            // |  (  |  7  |  8  |  9  |  )  |     |     |     |     |     |     |     |
            // |  +  |  4  |  5  |  6  |  *  |     |     |     | RSHFT | RCTL | RALT | RGUI |
            // |  -  |  1  |  2  |  3  |  /  |               |     |     |     |     |     |
            //                    |  .  |  0  |  =  |       |     |     |     |
            bindings = <
                &kp LPAR        &kp N7          &kp N8          &kp N9          &kp RPAR        &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &kp PLUS        &kp N4          &kp N5          &kp N6          &kp ASTRK       &trans          &trans          &trans          &kp RSHFT       &kp RCTL        &kp RALT        &kp RGUI
                &kp MINUS       &kp N1          &kp N2          &kp N3          &kp FSLH        &trans          &trans          &trans          &trans          &trans
                &kp DOT         &kp N0          &kp EQUAL       &trans          &trans          &trans
            >;
        };

        left_punc_layer {
            display-name = "Left Punctuation";
            // --------------------------------------------------------------------------------
            // |  +  |  &  |  *  |  _  |     |     |     |     |     |     |     |     |
            // |  =  |  $  |  %  |  ^  |     |     |     |     | RSHFT | RCTL | RALT | RGUI |
            // |  -  |  !  |  @  |  #  |     |               |     |     |     |     |     |
            //                    | ESC | SPC | TAB |       |     |     |     |
            bindings = <
                &kp PLUS        &kp AMPS        &kp ASTRK       &kp UNDER       &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &kp EQUAL       &kp DLLR        &kp PRCNT       &kp CARET       &trans          &trans          &trans          &trans          &kp RSHFT       &kp RCTL        &kp RALT        &kp RGUI
                &kp MINUS       &kp EXCL        &kp AT          &kp HASH        &trans          &trans          &trans          &trans          &trans          &trans
                &kp ESC         &kp SPACE       &kp TAB         &trans          &trans          &trans
            >;
        };

        function_layer {
            display-name = "Function";
            // --------------------------------------------------------------------------------
            // | F12 | F7  | F8  | F9  |     |     |     |     |     |     |     |     |
            // | F11 | F4  | F5  | F6  |     |     |     |     | RSHFT | RCTL | RALT | RGUI |
            // | F10 | F1  | F2  | F3  |     |               |     |     |     |     |     |
            //                    | ESC | SPC | TAB |       |     |     |     |
            bindings = <
                &kp F12         &kp F7          &kp F8          &kp F9          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &kp F11         &kp F4          &kp F5          &kp F6          &trans          &trans          &trans          &trans          &kp RSHFT       &kp RCTL        &kp RALT        &kp RGUI
                &kp F10         &kp F1          &kp F2          &kp F3          &trans          &trans          &trans          &trans          &trans          &trans
                &kp ESC         &kp SPACE       &kp TAB         &trans          &trans          &trans
            >;
        };
    };
};
