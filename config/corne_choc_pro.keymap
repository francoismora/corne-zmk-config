#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define MOUSE 1
#define RIGHT_PUNC 2
#define NAVIGATION 3
#define NUMPAD 4
#define LEFT_PUNC 5
#define FUNCTION 6

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // Left:  Q  W  E  R  T       Y  U  I  O  P   :Right
            //        A  S  D  F  G       H  J  K  L  ;
            //        Z  X  C  V  B       N  M  ,  .  /
            //              ESC SPC TAB   ENT BSPC DEL
            //              MOUSE R_PUNC NAV   NUMPAD L_PUNC FUNC
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I  &kp O    &kp P    &kp BSPC &kp TAB
                &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K  &kp L    &kp SEMI &kp SQT  &kp LCTRL
                &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC  &kp LSHFT
                &lt MOUSE ESC &lt RIGHT_PUNC SPACE &lt NAVIGATION TAB &lt NUMPAD RET &lt LEFT_PUNC BSPC &lt FUNCTION DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        right_punc_layer {
            display-name = "Right Punctuation";
            // Left:  trans  RET    DEL    BSPC  trans
            //        trans  trans   trans  trans  trans
            //        Undo   Cut    Copy   Paste  trans
            // Right: {  }  "  |  trans
            //        (  )  '  \  trans
            //        [  ]  `  ~  trans
            bindings = <
                &trans &kp RET &kp DEL &kp BSPC &trans &kp LBRC &kp RBRC &kp DQT &kp PIPE &trans &trans &trans
                &trans &trans &trans &trans &trans &kp LPAR &kp RPAR &kp SQT &kp BSLH &trans &trans &trans
                &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &trans &kp LBKT &kp RBKT &kp GRAVE &kp TILDE &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        navigation_layer {
            display-name = "Navigation";
            // Right: trans  PSCRN  SLCK   PAUSE  INS
            //         trans  LEFT   DOWN   UP     RIGHT
            //         trans  HOME   PG_DN  PG_UP  END
            bindings = <
                &trans &trans &trans &trans &trans &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &kp INS &trans &trans
                &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp PG_UP &kp END &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        numpad_layer {
            display-name = "NumPad";
            // Left:  (  7  8  9  )
            //        +  4  5  6  *
            //        -  1  2  3  /
            // Thumb:    .  0  =
            bindings = <
                &kp LPAR &kp N7 &kp N8 &kp N9 &kp RPAR &trans &trans &trans &trans &trans &trans &trans
                &kp PLUS &kp N4 &kp N5 &kp N6 &kp ASTRK &trans &trans &trans &trans &trans &trans &trans
                &kp MINUS &kp N1 &kp N2 &kp N3 &kp FSLH &trans &trans &trans &trans &trans &trans &trans
                &kp DOT &kp N0 &kp EQUAL &trans &trans &trans
            >;
        };

        left_punc_layer {
            display-name = "Left Punctuation";
            // Left:  +  &  *  _  trans
            //        =  $  %  ^  trans
            //        -  !  @  #  trans
            bindings = <
                &kp PLUS &kp AMPS &kp ASTRK &kp UNDER &trans &trans &trans &trans &trans &trans &trans &trans
                &kp EQUAL &kp DLLR &kp PRCNT &kp CARET &trans &trans &trans &trans &trans &trans &trans &trans
                &kp MINUS &kp EXCL &kp AT &kp HASH &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        function_layer {
            display-name = "Function";
            // Left:  F12  F7  F8  F9  trans
            //        F11  F4  F5  F6  trans
            //        F10  F1  F2  F3  trans
            bindings = <
                &kp F12 &kp F7 &kp F8 &kp F9 &trans &trans &trans &trans &trans &trans &trans &trans
                &kp F11 &kp F4 &kp F5 &kp F6 &trans &trans &trans &trans &trans &trans &trans &trans
                &kp F10 &kp F1 &kp F2 &kp F3 &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
